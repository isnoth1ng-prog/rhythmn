{
  "expo": {
    "name": "Rhythm",
    "slug": "rhythm-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rhythm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "work.baseshop.rhythm"
    },
    "android": {
      "package": "work.baseshop.rhythm",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router"
    ]
  }
}
